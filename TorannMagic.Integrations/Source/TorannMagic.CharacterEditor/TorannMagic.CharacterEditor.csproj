<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TorannMagic.CharacterEditor</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</GameDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies</HarmonyDir>
    <!-- No compile-time Character Editor reference: the adapter talks to
         CEditor.API through reflection only, so CE UI updates cannot break
         the build. The assembly is required at runtime only. -->
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TorannMagic"><HintPath>$(ModAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
