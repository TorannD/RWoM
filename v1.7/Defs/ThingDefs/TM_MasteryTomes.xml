<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Separate use effect: never inherit the legacy random class-book grant. -->
  <ThingDef ParentName="ResourceBase">
    <defName>TM_MasterTomePriest</defName>
    <label>master tome: priest</label>
    <description>A rare tome for a priest who has met the requirements for mastery. Reading it completes the corresponding initiation and consumes the tome. Available from traders and quest rewards; it cannot be crafted.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <tradeNeverStack>true</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <thingCategories><li>TM_SkillBooks</li></thingCategories>
    <tradeTags><li>ArcaneSkillBooks</li></tradeTags>
    <tradeability>All</tradeability>
    <thingSetMakerTags><li>RewardStandardLowFreq</li></thingSetMakerTags>
    <statBases>
      <!-- Native standard quest rewards cap the special-item budget at 5500. -->
      <MarketValue>5000</MarketValue>
      <MaxHitPoints>1000</MaxHitPoints>
      <Mass>0.2</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>0.0001</DeteriorationRate>
      <Beauty>10</Beauty>
      <SellPriceFactor>0.8</SellPriceFactor>
    </statBases>
    <stackLimit>1</stackLimit>
    <techLevel>Neolithic</techLevel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Usable">
        <useJob>UseArtifact</useJob>
        <useLabel>Read {0_label}</useLabel>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>TorannMagic.ClassProgression.CompUseEffect_MasterTome</compClass>
      </li>
    </comps>
    <graphicData>
      <texPath>Books/priest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>
