<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <TorannMagic.TMAbilityDef ParentName="BaseMightAbility">
    <defName>TM_SniperAimedShot</defName>
    <label>aimed shot</label>
    <uiIconPath>UI/headshot</uiIconPath>
    <description>Fire a single ordinary bullet at a hostile target for 110/125/140% weapon damage, using the weapon’s range, accuracy and cover rules.</description>
    <staminaCost>0.25</staminaCost>
    <MainVerb Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.ClassProgression.Verb_SniperAimedShot</verbClass>
      <tooltipShowProjectileDamage>false</tooltipShowProjectileDamage>
      <tooltipShowExtraDamages>false</tooltipShowExtraDamages>
      <tooltipShowHediffsToApply>false</tooltipShowHediffsToApply>
      <tooltipShowMentalStatesToApply>false</tooltipShowMentalStatesToApply>
      <hasStandardCommand>true</hasStandardCommand>
      <abilityDef>TM_SniperAimedShot</abilityDef>
      <isViolent>true</isViolent>
      <defaultProjectile>TM_SniperAimedRound</defaultProjectile>
      <warmupTime>1</warmupTime>
      <SecondsToRecharge>30</SecondsToRecharge>
      <range>100</range>
      <muzzleFlashScale>20</muzzleFlashScale>
      <isPrimary>true</isPrimary>
      <AbilityTargetCategory>TargetThing</AbilityTargetCategory>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </MainVerb>
    <modExtensions>
      <li Class="TorannMagic.Core.SpellIdentityExtension" MayRequire="huginn.rwom.core">
        <spellId>rwom.tm_sniperaimedshot</spellId>
        <domain>Might</domain>
        <tier>0</tier>
      </li>
    </modExtensions>
  </TorannMagic.TMAbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>TM_SniperAimedRound</defName>
    <label>aimed bullet</label>
    <thingClass>TorannMagic.ClassProgression.SniperAimedBullet</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>
</Defs>