<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <TorannMagic.TMAbilityDef ParentName="BaseMightAbility">
    <defName>TM_GladiatorManeuver</defName>
    <label>maneuver</label>
    <uiIconPath>UI/sprint2</uiIconPath>
    <description>Increase movement speed by 8% for 8 seconds.</description>
    <staminaCost>0.12</staminaCost>
    <MainVerb Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.ClassProgression.Verb_GladiatorManeuver</verbClass>
      <tooltipShowProjectileDamage>false</tooltipShowProjectileDamage>
      <tooltipShowExtraDamages>false</tooltipShowExtraDamages>
      <tooltipShowHediffsToApply>false</tooltipShowHediffsToApply>
      <tooltipShowMentalStatesToApply>false</tooltipShowMentalStatesToApply>
      <hasStandardCommand>true</hasStandardCommand>
      <abilityDef>TM_GladiatorManeuver</abilityDef>
      <isViolent>false</isViolent>
      <defaultProjectile>TM_Gladiator_Sprint</defaultProjectile>
      <warmupTime>.5</warmupTime>
      <SecondsToRecharge>25</SecondsToRecharge>
      <range>0</range>
      <soundCast>Message_PositiveEvent</soundCast>
      <muzzleFlashScale>20</muzzleFlashScale>
      <isPrimary>false</isPrimary>
      <AbilityTargetCategory>TargetSelf</AbilityTargetCategory>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>true</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </MainVerb>
    <modExtensions>
      <li Class="TorannMagic.Core.SpellIdentityExtension" MayRequire="huginn.rwom.core">
        <spellId>rwom.tm_gladiatormaneuver</spellId>
        <domain>Might</domain>
        <tier>0</tier>
      </li>
    </modExtensions>
  </TorannMagic.TMAbilityDef>
