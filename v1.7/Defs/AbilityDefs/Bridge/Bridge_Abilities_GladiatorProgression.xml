<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <AbilityDef Class="TorannMagic.TMBridgeAbilityDef" ParentName="TMBridgeAbilityBase">
    <defName>TM_Bridge_GladiatorManeuver</defName>
    <label>maneuver</label>
    <description>Increase movement speed by 8% for 8 seconds.</description>
    <spellId>rwom.tm_gladiatormaneuver</spellId>
    <iconPath>UI/sprint2</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <verbProperties Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.ClassProgression.Verb_GladiatorManeuver</verbClass>
      <tooltipShowProjectileDamage>false</tooltipShowProjectileDamage>
      <tooltipShowExtraDamages>false</tooltipShowExtraDamages>
      <tooltipShowHediffsToApply>false</tooltipShowHediffsToApply>
      <tooltipShowMentalStatesToApply>false</tooltipShowMentalStatesToApply>
      <hasStandardCommand>true</hasStandardCommand>
      <abilityDef>TM_GladiatorManeuver</abilityDef>
      <isViolent>false</isViolent>
      <defaultProjectile>TM_Gladiator_Sprint</defaultProjectile>
      <warmupTime>.5</warmupTime>
      <SecondsToRecharge>25</SecondsToRecharge>
      <range>0</range>
      <soundCast>Message_PositiveEvent</soundCast>
      <muzzleFlashScale>20</muzzleFlashScale>
      <isPrimary>true</isPrimary>
      <AbilityTargetCategory>TargetSelf</AbilityTargetCategory>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>true</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
  </AbilityDef>
  <AbilityDef Class="TorannMagic.TMBridgeAbilityDef" ParentName="TMBridgeAbilityBase">
    <defName>TM_Bridge_GladiatorSweep</defName>
    <label>sweeping blow</label>
    <description>Strike a chosen adjacent enemy and up to one enemy beside them for 65% weapon damage each.</description>
    <spellId>rwom.tm_gladiatorsweep</spellId>
    <iconPath>UI/cleave</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <verbProperties Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.ClassProgression.Verb_GladiatorSweep</verbClass>
      <tooltipShowProjectileDamage>false</tooltipShowProjectileDamage>
      <tooltipShowExtraDamages>false</tooltipShowExtraDamages>
      <tooltipShowHediffsToApply>false</tooltipShowHediffsToApply>
      <tooltipShowMentalStatesToApply>false</tooltipShowMentalStatesToApply>
      <hasStandardCommand>true</hasStandardCommand>
      <abilityDef>TM_GladiatorSweep</abilityDef>
      <isViolent>true</isViolent>
      <defaultProjectile>TM_Gladiator_Sprint</defaultProjectile>
      <warmupTime>.5</warmupTime>
      <SecondsToRecharge>15</SecondsToRecharge>
      <range>1.5</range>
      <soundCast>Message_PositiveEvent</soundCast>
      <muzzleFlashScale>20</muzzleFlashScale>
      <isPrimary>true</isPrimary>
      <AbilityTargetCategory>TargetThing</AbilityTargetCategory>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
  </AbilityDef>
