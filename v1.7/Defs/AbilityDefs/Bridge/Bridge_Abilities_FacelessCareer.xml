    <defName>TM_Bridge_FacelessEcho</defName>
    <label>Borrowed technique</label>
    <description>Echo the last imitated technique at a range of 18. Elemental and martial echoes inflict 12 damage. A medical echo heals 4 points of one wound. Costs 20% stamina; 30-second cooldown.</description>
    <spellId>rwom.tm_facelessecho</spellId>
    <iconPath>UI/mimic</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
