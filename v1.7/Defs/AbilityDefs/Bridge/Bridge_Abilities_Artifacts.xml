<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef Class="TorannMagic.TMBridgeAbilityDef" ParentName="TMBridgeAbilityBase">
    <defName>TM_Bridge_ArtifactConviction</defName>
    <label>Conviction</label>
    <description>Overpower a pawn with conviction to join your cause. This power will exact a heavy toll on the caster.
		
Use of Conviction will destroy the orb.</description>
    <spellId>rwom.tm_artifact_conviction</spellId>
    <iconPath>UI/orb_conviction</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <verbProperties Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.Enchantment.Verb_OrbTraitor</verbClass>
      <tooltipShowProjectileDamage>false</tooltipShowProjectileDamage>
      <tooltipShowExtraDamages>false</tooltipShowExtraDamages>
      <tooltipShowHediffsToApply>false</tooltipShowHediffsToApply>
      <tooltipShowMentalStatesToApply>false</tooltipShowMentalStatesToApply>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Projectile_Default</defaultProjectile>
      <abilityDef>TM_Artifact_Conviction</abilityDef>
      <warmupTime>2</warmupTime>
      <SecondsToRecharge>600</SecondsToRecharge>
      <range>50</range>
      <burstShotCount>1</burstShotCount>
      <soundCast>TM_Gong</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <muzzleFlashScale>30</muzzleFlashScale>
      <AlwaysHits>true</AlwaysHits>
      <isPrimary>true</isPrimary>
      <isViolent>false</isViolent>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
  </AbilityDef>
  <AbilityDef Class="TorannMagic.TMBridgeAbilityDef" ParentName="TMBridgeAbilityBase">
    <defName>TM_Bridge_WeaponWintersfury</defName>
    <label>Winter's Fury</label>
    <description>Covers the map in rolling waves of dark, angry clouds carrying winters' biting scorn.</description>
    <spellId>rwom.tm_weapon_wintersfury</spellId>
    <iconPath>UI/wintersfury</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <verbProperties Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.Enchantment.Verb_WeaponWintersFury</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Projectile_Default</defaultProjectile>
      <abilityDef>TM_Weapon_WintersFury</abilityDef>
      <AbilityTargetCategory>TargetSelf</AbilityTargetCategory>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>true</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
      <warmupTime>5</warmupTime>
      <SecondsToRecharge>600000</SecondsToRecharge>
      <range>0</range>
      <isViolent>false</isViolent>
      <burstShotCount>1</burstShotCount>
      <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
      <soundCast>Message_PositiveEvent</soundCast>
      <muzzleFlashScale>0</muzzleFlashScale>
      <isPrimary>true</isPrimary>
    </verbProperties>
  </AbilityDef>
</Defs>
