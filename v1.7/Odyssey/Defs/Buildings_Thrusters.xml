        <defaultManaMode>Off</defaultManaMode>
        <defaultFuelMode>Receive</defaultFuelMode>
      </li>
    </comps>
    <uiOrder>2205</uiOrder>
    <placeWorkers>
      <li>TorannMagic.Odyssey.PlaceWorker_ManaNetwork</li>
    </placeWorkers>
  </ThingDef>
</Defs>
