<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="TM_BuildingBase">
    <defName>TM_CombatShieldGenerator</defName>
    <label>combat shield generator</label>
    <description>Creates a combat shield within 5 cells of itself and connected mana beacons. One generator operates per connected network; others remain on standby. Provides 1000 shield HP; connected boosters add 250 HP each and absorb damage first. New sources start empty and require mana to charge. Each source retains its own shield HP when disconnected or moved. Regenerates 25 HP per second across the network after 10 seconds without hits, at 0.01 mana per HP. A collapsed shield waits 30 seconds before recharging. Upkeep costs 0.0005 mana per protected cell per second. Uses a 100-mana buffer and no fuel. Friendly, outgoing, and internally originating shots pass. Works alongside thermal shields without replacing them. After 60 seconds without hostile creatures on the map or shield hits, upkeep falls to 10%. Shield strength and HP repair cost do not change.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Buildings/CombatShield</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.2,2.2)</drawSize>
      <allowFlip>false</allowFlip>
    </graphicData>
    <placeWorkers>
      <li>TorannMagic.Odyssey.PlaceWorker_ManaNetwork</li>
    </placeWorkers>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>TM_RWoM</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <RawMagicyte>150</RawMagicyte>
    </costList>
    <researchPrerequisites>
      <li>TM_MagofuelRefining</li>
      <li>OrbitalTech</li>
    </researchPrerequisites>
    <comps>
      <li Class="TorannMagic.Odyssey.CompProperties_CrystalGlow"><state>Service</state><diameter>1.03</diameter><north>(0.49,0.44)</north><east>(0.49,0.44)</east><south>(0.49,0.44)</south><west>(0.49,0.44)</west></li>
      <li Class="TorannMagic.Odyssey.CompProperties_MagicalCombat">
        <hitPoints>1000</hitPoints>
        <regenerationPerSecond>25</regenerationPerSecond>
        <manaPerHitPoint>0.01</manaPerHitPoint>
        <manaPerCellSecond>0.0005</manaPerCellSecond>
        <regenerationDelayTicks>600</regenerationDelayTicks>
        <rebootTicks>1800</rebootTicks>
      </li>
<li Class="TorannMagic.Odyssey.CompProperties_MagicalCombatInterceptor" />
<li Class="TorannMagic.Odyssey.CompProperties_ShieldManaBuffer"><manaCapacity>100</manaCapacity><maxTransfer>10</maxTransfer></li>
<li Class="TorannMagic.Odyssey.CompProperties_ManaNetworkEndpoint"><supportsMana>true</supportsMana><supportsFuel>false</supportsFuel><defaultManaMode>Receive</defaultManaMode><defaultFuelMode>Off</defaultFuelMode></li>
<li Class="CompProperties_Flickable" /><li Class="CompProperties_Breakdownable" /></comps>
  </ThingDef>
  <ThingDef ParentName="TM_BuildingBase">
    <defName>TM_CombatShieldBooster</defName>
    <label>combat shield booster</label>
    <description>Adds 250 shield HP to an active combat shield generator on the same connected mana beacon network. Booster HP absorbs incoming damage before the generator. Starts empty; its own shield HP persists through disconnection and moving. Charges through the active generator at the shared regeneration rate. Does not extend shield coverage, store mana, or use fuel. Cannot create a shield without a generator.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Buildings/ShieldBooster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,1.4)</drawSize>
      <allowFlip>false</allowFlip>
    </graphicData>
    <placeWorkers>
      <li>TorannMagic.Odyssey.PlaceWorker_ManaNetwork</li>
    </placeWorkers>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>TM_RWoM</designationCategory>
    <hasInteractionCell>false</hasInteractionCell>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
      <RawMagicyte>50</RawMagicyte>
    </costList>
    <researchPrerequisites>
      <li>TM_MagofuelRefining</li>
      <li>OrbitalTech</li>
    </researchPrerequisites>
    <comps>
      <li Class="TorannMagic.Odyssey.CompProperties_CrystalGlow"><state>Service</state><diameter>0.6</diameter><north>(0.5,0.35)</north><east>(0.5,0.35)</east><south>(0.5,0.35)</south><west>(0.5,0.35)</west></li>
      <li Class="TorannMagic.Odyssey.CompProperties_MagicalCombatBooster">
        <hitPoints>250</hitPoints>
      </li>
<li Class="TorannMagic.Odyssey.CompProperties_ManaNetworkEndpoint"><supportsMana>false</supportsMana><supportsFuel>false</supportsFuel><defaultManaMode>Off</defaultManaMode><defaultFuelMode>Off</defaultFuelMode></li>
<li Class="CompProperties_Flickable" /><li Class="CompProperties_Breakdownable" /></comps>
  </ThingDef>
</Defs>