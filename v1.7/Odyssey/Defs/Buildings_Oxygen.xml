<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="TM_BuildingBase">
    <defName>TM_MagicalOxygen</defName>
    <label>magical oxygen generator</label>
    <description>Creates breathable atmosphere within 5 cells of itself and connected mana beacons, even in open vacuum. Uses mana or magicyte without electricity or automatic resource switching. Each generator supports 250 cells at 0.1 mana per second; one magicyte supplies 100 seconds at full output. Larger fields receive partial pressure unless more generators supply the connected network. Stores 100 mana and 50 magicyte. Provides no heat or temperature protection. Air remains through one missed one-second supply check; two consecutive missed checks restore vacuum. On planets outside vacuum, atmosphere mode stays idle: it consumes no resources and requests no network mana or automatic fuel conversion. VGE pipe-network output still consumes resources on planets.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Buildings/MagicalOxygen</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.2,2.2)</drawSize>
      <allowFlip>false</allowFlip>
    </graphicData>
    <placeWorkers>
      <li>TorannMagic.Odyssey.PlaceWorker_ManaNetwork</li>
    </placeWorkers>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>TM_RWoM</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <RawMagicyte>100</RawMagicyte>
    </costList>
    <researchPrerequisites>
      <li>TM_MagofuelRefining</li>
      <li>OrbitalTech</li>
    </researchPrerequisites>
    <comps>
      <li Class="TorannMagic.Odyssey.CompProperties_CrystalGlow"><state>Service</state><diameter>0.81</diameter><north>(0.5,0.275)</north><east>(0.367,0.29)</east><south>(0.49,0.275)</south><west>(0.63,0.29)</west></li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>50</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <functionsInVacuum>true</functionsInVacuum>
        <fuelMultiplier>1</fuelMultiplier>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>50</initialConfigurableTargetFuelLevel>
        <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <fuelLabel>Magicyte</fuelLabel>
        <fuelGizmoLabel>Magicyte</fuelGizmoLabel>
        <fuelFilter>
          <thingDefs>
            <li>RawMagicyte</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="TorannMagic.Odyssey.CompProperties_MagicalOxygen">
        <manaPerSecond>0.1</manaPerSecond>
        <manaPerMagicyte>10</manaPerMagicyte>
        <pulseInterval>60</pulseInterval>
      </li>
      <li Class="TorannMagic.Odyssey.CompProperties_OxygenManaBuffer">
        <manaCapacity>100</manaCapacity>
        <maxTransfer>10</maxTransfer>
      </li>
      <li Class="TorannMagic.Odyssey.CompProperties_ManaNetworkEndpoint">
        <supportsMana>true</supportsMana>
        <supportsFuel>false</supportsFuel>
        <defaultManaMode>Receive</defaultManaMode>
        <defaultFuelMode>Off</defaultFuelMode>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
  </ThingDef>
</Defs>