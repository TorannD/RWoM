<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef>
    <defName>TM_BreachSealWall</defName>
    <label>Breach Seal</label>
    <description>Creates up to three airtight magical walls on the far edge of a selected 3×3 area, away from the ship core. Requires an owned ship platform and intact floor. Each wall has 300 hit points and lasts one day. Existing allied airtight walls are preserved; active seals cannot be refreshed. Does not repair floors or roofs and supplies no oxygen.</description>
    <thingClass>TorannMagic.Odyssey.Building_BreachSeal</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Spells/invis</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
      <MarketValue>0</MarketValue>
    </statBases>
    <size>(1,1)</size>
    <useHitPoints>true</useHitPoints>
    <destroyable>true</destroyable>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <holdsRoof>true</holdsRoof>
    <blockWind>true</blockWind>
    <coversFloor>true</coversFloor>
    <tickerType>Normal</tickerType>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <building>
      <isEdifice>true</isEdifice>
      <isWall>true</isWall>
      <isAirtight>true</isAirtight>
      <isStuffableAirtight>false</isStuffableAirtight>
      <expandHomeArea>false</expandHomeArea>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <isPlayerEjectable>false</isPlayerEjectable>
    </building>
    <comps>
      <li Class="CompProperties_DestroyAfterDelay">
        <delayTicks>60000</delayTicks>
        <destroyMode>Vanish</destroyMode>
      </li>
    </comps>
  </ThingDef>
  <TorannMagic.TMAbilityDef ParentName="BaseMagicAbility">
    <defName>TM_BreachSeal</defName>
    <label>Breach Seal</label>
    <description>Creates up to three airtight magical walls on the far edge of a selected 3×3 area, away from the ship core. Requires an owned ship platform and intact floor. Each wall has 300 hit points and lasts one day. Existing allied airtight walls are preserved; active seals cannot be refreshed. Does not repair floors or roofs and supplies no oxygen. Range: 15 cells. Preparation: 1 second. Cooldown: 60 seconds. Costs 30% mana before efficiency modifiers.</description>
    <abilityClass>TorannMagic.Odyssey.BreachSealAbility</abilityClass>
    <uiIconPath>UI/Abilities/BreachSeal</uiIconPath>
    <manaCost>0.3</manaCost>
    <efficiencyReductionPercent>0.1</efficiencyReductionPercent>
    <learnItem>SpellOf_BreachSeal</learnItem>
    <MainVerb Class="AbilityUser.VerbProperties_Ability">
      <verbClass>TorannMagic.Verb_BreachSeal</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <requiresLineOfSight>true</requiresLineOfSight>
      <defaultProjectile>Projectile_TM_SpawnThing</defaultProjectile>
      <abilityDef>TM_BreachSeal</abilityDef>
      <warmupTime>1</warmupTime>
      <SecondsToRecharge>60</SecondsToRecharge>
      <range>15</range>
      <burstShotCount>1</burstShotCount>
      <soundCast>TM_Vibration</soundCast>
      <AbilityTargetCategory>TargetLocation</AbilityTargetCategory>
      <AlwaysHits>true</AlwaysHits>
      <isPrimary>true</isPrimary>
      <isViolent>false</isViolent>
      <targetParams>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </MainVerb>
  </TorannMagic.TMAbilityDef>
  <TorannMagic.TM_CustomPowerDef>
    <defName>TM_BreachSealPower</defName>
    <customPower>
      <forMage>true</forMage>
      <maxLevel>0</maxLevel>
