  <ThingDef ParentName="ArcaneSpellBase">
    <defName>SpellOf_BreachSeal</defName>
    <label>Breach Seal — learning scroll</label>
    <description>Teaches Breach Seal to a mage able to learn general spells. Creates up to three airtight magical walls on the far edge of a selected 3×3 area, away from the ship core. Requires an owned ship platform and intact floor. Each wall has 300 hit points and lasts one day. Existing allied airtight walls are preserved; active seals cannot be refreshed. Does not repair floors or roofs and supplies no oxygen.</description>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>1075</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <graphicData>
      <texPath>Books/scroll</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <RawMagicyte>200</RawMagicyte>
      <DevilstrandCloth>40</DevilstrandCloth>
    </costList>
    <recipeMaker>
      <workAmount>2000</workAmount>
      <workSpeedStat>WorkSpeedGlobal</workSpeedStat>
      <workSkill>Intellectual</workSkill>
      <recipeUsers>
        <li>TableMagicPrinter</li>
      </recipeUsers>
      <effectWorking>Smelt</effectWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <skillRequirements>
        <Crafting>2</Crafting>
        <Intellectual>8</Intellectual>
      </skillRequirements>
      <researchPrerequisite>TM_AdvancedScribing</researchPrerequisite><researchPrerequisites><li>OrbitalTech</li></researchPrerequisites>
    </recipeMaker>
  </ThingDef>
  <ThingDef ParentName="TM_CastScrollBase">
    <defName>TM_CastScroll_BreachSeal</defName>
    <label>Breach Seal — cast scroll</label>
    <description>Creates up to three airtight magical walls on the far edge of a selected 3×3 area, away from the ship core. Requires an owned ship platform and intact floor. Each wall has 300 hit points and lasts one day. Existing allied airtight walls are preserved; active seals cannot be refreshed. Does not repair floors or roofs and supplies no oxygen. Use from inventory. Consumes one scroll only on success. Anyone can use it without mana or learned magic. Range: 15 cells. Preparation: 1 second. Cooldown: 60 seconds.</description>
    <statBases>
      <MarketValue>360</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Items/SpellItems/Scroll_BreachSeal</texPath>
