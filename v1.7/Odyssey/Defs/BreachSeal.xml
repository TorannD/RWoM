        <maxUses>1</maxUses>
        <requiresEquipped>false</requiresEquipped>
        <range>15</range>
        <warmupTicks>60</warmupTicks>
        <cooldownTicks>3600</cooldownTicks>
      </li>
    </comps>
  </ThingDef>
  <RecipeDef ParentName="TM_SpellItemRecipeBase">
