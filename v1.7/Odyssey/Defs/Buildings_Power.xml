<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="TM_BuildingBase">
    <defName>TM_MagofuelGenerator</defName>
    <label>magofuel generator</label>
    <description>Burns magofuel to supply 3000 W to an electrical grid, consuming 3 fuel per day and releasing 6 heat per second while generating. Works in vacuum. Stops while switched off, broken down, disconnected or out of fuel. Unburned fuel in the core remains stored when the generator stops or is moved.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Buildings/MagofuelGenerator</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Source PNGs include transparent margins; visible body fits the 2x2 footprint. -->
      <drawSize>(2.4,2.4)</drawSize>
      <allowFlip>false</allowFlip>
    </graphicData>
    <placeWorkers>
      <li>TorannMagic.Odyssey.PlaceWorker_ManaNetwork</li>
    </placeWorkers>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>TM_RWoM</designationCategory>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <RawMagicyte>100</RawMagicyte>
    </costList>
    <researchPrerequisites>
      <li>TM_MagofuelRefining</li>
      <li>Electricity</li>
    </researchPrerequisites>
    <comps>
      <li Class="TorannMagic.Odyssey.CompProperties_CrystalGlow"><state>Power</state><diameter>0.7</diameter><north>(0.49,0.3)</north><east>(0.49,0.3)</east><south>(0.49,0.3)</south><west>(0.49,0.3)</west></li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>50</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <functionsInVacuum>true</functionsInVacuum>
        <fuelMultiplier>1</fuelMultiplier>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>50</initialConfigurableTargetFuelLevel>
        <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <fuelFilter>
          <thingDefs>
            <li>TM_Magofuel</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="TorannMagic.Odyssey.CompProperties_MagofuelPower">
        <basePowerConsumption>-3000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <fuelPerDay>3</fuelPerDay>
        <heatPerSecond>6</heatPerSecond>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="TorannMagic.Odyssey.CompProperties_ManaNetworkEndpoint">
        <supportsMana>false</supportsMana>
        <defaultManaMode>Off</defaultManaMode>
        <defaultFuelMode>Receive</defaultFuelMode>
      </li>
    </comps>
  </ThingDef>
</Defs>


