<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!-- A RimWorld of Magic — RimWorld 1.7 (Waylith) build.
       Reference assemblies are produced in D:\golang\RWoM\refs (see refs/README). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj48/**</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TorannMagic</RootNamespace>
    <AssemblyName>TorannMagic</AssemblyName>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\v1.7\Assemblies\</OutputPath>
    <!-- Legacy AssemblyInfo.cs is maintained manually -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0618;CS0612;CS0108;CS0114;SYSLIB0011</NoWarn>
    <!-- keep transient files of old project layout out of the compile set -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;*.old</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld 1.7 reference assemblies (Assembly-CSharp + UnityStubs as UnityEngine) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4982-unstable" />
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony as shipped for RimWorld 1.7 -->
    <Reference Include="0Harmony">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AbilityUser framework (JecsLite dependency), rebuilt for 1.7 in D:\golang\RWoM\refs -->
    <Reference Include="AbilityUser">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\refs\out\AbilityUser.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AbilityUserAI">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\refs\out\AbilityUserAI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CompDeflector">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\refs\out\CompDeflector.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
